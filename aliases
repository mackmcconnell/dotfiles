alias s='cursor .'

# ==============================================================================
# Path shortcuts (zsh global aliases)
# ==============================================================================
# `alias -g` expands ANYWHERE on the command line, not just in command position.
# So all of these work: `cursor agents`, `vim agents`, `cat agents`,
# `git diff agents`. Both spellings are defined so muscle memory doesn't matter.
#
# Points at the real file in the dotfiles repo, not the ~/.codex/AGENTS.md
# symlink, so edits show up in `git status` here.
#
# Escape with a backslash if you ever need the literal word: `mkdir \agents`
alias -g agents="$HOME/code/dotfiles/codex/AGENTS.md"
alias -g agents.md="$HOME/code/dotfiles/codex/AGENTS.md"

connectToHeroku() {
    #do things with parameters like $1 such as
    heroku run script/rails console --app $1
}
alias prod=connectToHeroku



touchRtfDoc() {
    # touch doesn't traditionally work with rtf docs
    # so use this alias to mimic the functionality
    echo '{\rtf1}' > $1.rtf 
}
alias rtf=touchRtfDoc

